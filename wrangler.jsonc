{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chameleondetailing",
  "main": "worker/entry.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "APP_NAME": "ChameleonDetailing",
    "APP_URL": "https://chameleondetailing.black-sci-official.workers.dev",
    "BOT_USERNAME": "ChameleonDetailing_bot",
    "OWNER_TELEGRAM_ID": "375938798",
    "DEFAULT_LOCALE": "en",
    "DEFAULT_CURRENCY": "PLN",
    "BUSINESS_TIMEZONE": "Europe/Warsaw",
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chameleondetailing",
      "database_id": "167770dd-95c2-484c-b157-1fc369cee19c",
      "migrations_dir": "database/migrations"
    }
  ],
  "previews": {
    "vars": {
      "ENVIRONMENT": "staging"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "ba923545-0c9e-405d-a65a-cb5bdb7b590c"
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  }
}
