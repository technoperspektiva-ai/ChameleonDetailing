{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ChameleonDetailing",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "vars": {
    "APP_NAME": "ChameleonDetailing",
    "BOT_USERNAME": "ChameleonDetailing_bot",
    "OWNER_TELEGRAM_ID": "375938798",
    "DEFAULT_LOCALE": "en",
    "DEFAULT_CURRENCY": "PLN",
    "BUSINESS_TIMEZONE": "Europe/Warsaw"
  },
  "observability": { "enabled": true }
}
