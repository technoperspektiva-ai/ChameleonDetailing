{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chameleondetailing-staging",
  "main": "worker/entry.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "APP_NAME": "ChameleonDetailing Staging",
    "APP_URL": "https://chameleondetailing-staging.black-sci-official.workers.dev",
    "BOT_USERNAME": "ChameleonDetailing_bot",
    "OWNER_TELEGRAM_ID": "375938798",
    "DEFAULT_LOCALE": "en",
    "DEFAULT_CURRENCY": "PLN",
    "BUSINESS_TIMEZONE": "Europe/Warsaw",
    "ENVIRONMENT": "staging"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chameleondetailing-staging",
      "database_id": "ba923545-0c9e-405d-a65a-cb5bdb7b590c",
      "migrations_dir": "database/migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  }
}
